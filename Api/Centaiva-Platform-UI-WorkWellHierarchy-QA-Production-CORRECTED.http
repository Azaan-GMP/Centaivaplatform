Authorization: Bearer {{qaPlatformOwnerLogin.response.body.$.access_token}}
Content-Type: application/json
Accept: application/json

{
  "newPassword": "{{uiTestUserTempPassword}}",
  "mustChangePassword": true,
  "reason": "QA UI password reset verification"
}

