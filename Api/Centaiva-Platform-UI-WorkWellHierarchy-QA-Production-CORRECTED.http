###############################################################################
# H1 - CREATE USER
###############################################################################

# @name qaCreateUiUser
POST {{qaCentaivaUrl}}/api/v1/platform/users HTTP/1.1
Authorization: Bearer {{qaPlatformOwnerLogin.response.body.$.access_token}}
Content-Type: application/json
Accept: application/json

{
  "email": "{{uiTestUserEmail}}",
  "displayName": "{{uiTestUserName}}",
  "temporaryPassword": "{{uiTestUserTempPassword}}",
  "status": 1,
  "emailConfirmed": true,
  "mustChangePassword": true,
  "preferredLocale": "en-GB",
  "timeZoneId": "Europe/London"
}

###


###############################################################################
# H2 - LOOK UP USER
###############################################################################

# @name qaUiUser
GET {{qaCentaivaUrl}}/api/v1/platform/users/by-email?email={{uiTestUserEmail}} HTTP/1.1
Authorization: Bearer {{qaPlatformOwnerLogin.response.body.$.access_token}}
Accept: application/json

###


###############################################################################
# H3 - UPDATE USER
###############################################################################

PUT {{qaCentaivaUrl}}/api/v1/platform/users/{{qaUiUser.response.body.$.id}} HTTP/1.1
Authorization: Bearer {{qaPlatformOwnerLogin.response.body.$.access_token}}
Content-Type: application/json
Accept: application/json

{
  "displayName": "{{uiTestUserName}}",
  "phoneNumber": null,
  "preferredLocale": "en-GB",
  "timeZoneId": "Europe/London"
}

###


###############################################################################
# H4 - ADD USER TO EUTOPIA TENANT
###############################################################################

POST {{qaCentaivaUrl}}/api/v1/platform/tenants/{{eutopiaTenantId}}/members HTTP/1.1
Authorization: Bearer {{qaPlatformOwnerLogin.response.body.$.access_token}}
Content-Type: application/json
Accept: application/json

{
  "userId": "{{qaUiUser.response.body.$.id}}",
  "membershipStatus": "Active",
  "isBillableSeat": true
}

###


###############################################################################
# H5 - ASSIGN ROLE
###############################################################################

POST {{qaCentaivaUrl}}/api/v1/role-assignments HTTP/1.1
Authorization: Bearer {{qaPlatformOwnerLogin.response.body.$.access_token}}
Content-Type: application/json
Accept: application/json

{
  "roleId": "{{targetRoleId}}",
  "userId": "{{qaUiUser.response.body.$.id}}",
  "organizationId": null,
  "tenantId": "{{eutopiaTenantId}}",
  "expiresAtUtc": null
}

###


###############################################################################
