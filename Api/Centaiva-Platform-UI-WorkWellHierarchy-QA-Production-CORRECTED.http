###############################################################################
###############################################################################
# PART E - QA WORKWELL FINANCE PRODUCT LOGIN + TENANT PICKER
###############################################################################
###############################################################################


###############################################################################
# E1 - TALHA ENTERS WORKWELL FINANCE THROUGH PRODUCT CLIENT
#
# If Talha has >1 eligible WORKWELL_FINANCE tenant:
#   expected token_purpose = tenant_selection
#   tenant_id absent
#
# If only one eligible tenant:
#   Centaiva may auto-select and issue final Finance token.
###############################################################################

# @name qaTalhaFinancePreLogin
POST {{qaCentaivaUrl}}/connect/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded
Accept: application/json

grant_type=password&client_id=workwell-finance-web&username=talha.hassan@centaiva.com&password=Password123!&scope=openid%20profile%20email%20roles%20workwell.finance

###


###############################################################################
# E2 - ELIGIBLE WORKWELL FINANCE TENANTS
# Expected for Platform Owner when WORKWELL_FINANCE access/subscriptions are active:
# - Eutopia Search
# - Patrick Morgan
# - MedPure
###############################################################################

# @name qaTalhaFinanceTenants
GET {{qaCentaivaUrl}}/api/v1/me/tenants?applicationKey={{financeApplicationKey}} HTTP/1.1
Authorization: Bearer {{qaTalhaFinancePreLogin.response.body.$.access_token}}
Accept: application/json

###


###############################################################################
# E3 - SELECT EUTOPIA
###############################################################################

# @name qaSelectEutopia
POST {{qaCentaivaUrl}}/api/v1/me/select-tenant HTTP/1.1
Authorization: Bearer {{qaTalhaFinancePreLogin.response.body.$.access_token}}
Content-Type: application/json
Accept: application/json

{
  "tenantId": "{{eutopiaTenantId}}",
  "applicationKey": "{{financeApplicationKey}}"
}

###


###############################################################################
# E4 - EXCHANGE SELECTION CODE
###############################################################################

# @name qaEutopiaFinanceToken
POST {{qaCentaivaUrl}}/connect/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded
Accept: application/json

grant_type=urn%3Acentaiva%3Aparams%3Aoauth%3Agrant-type%3Atenant-selection&client_id={{financeClientId}}&selection_code={{qaSelectEutopia.response.body.$.selectionCode}}&scope={{financeScope}}

###


###############################################################################
# E5 - VERIFY WORKWELL CONTEXT
###############################################################################

GET {{qaWorkwellUrl}}/api/platform-context HTTP/1.1
Authorization: Bearer {{qaEutopiaFinanceToken.response.body.$.access_token}}
Accept: application/json

###

GET {{qaWorkwellUrl}}/api/companies/me HTTP/1.1
Authorization: Bearer {{qaEutopiaFinanceToken.response.body.$.access_token}}
Accept: application/json

###

GET {{qaWorkwellUrl}}/api/users HTTP/1.1
Authorization: Bearer {{qaEutopiaFinanceToken.response.body.$.access_token}}
Accept: application/json

###

GET {{qaWorkwellUrl}}/api/roles HTTP/1.1
Authorization: Bearer {{qaEutopiaFinanceToken.response.body.$.access_token}}
Accept: application/json

###


###############################################################################
# E5A - TENANT-BOUND SESSION POLICY
#
# This is the correct place to test tenant authentication policy.
# Expected target: maxSessionHours=10, idleTimeoutMinutes=600 where configured.
###############################################################################

GET {{qaCentaivaUrl}}/api/v1/me/session-policy HTTP/1.1
Authorization: Bearer {{qaEutopiaFinanceToken.response.body.$.access_token}}
Accept: application/json

###


###############################################################################
# E6 - SWITCH EUTOPIA -> PATRICK MORGAN
#
# Fill @patrickMorganTenantId first.
# Canonical UI route after final login = /api/v1/me/switch-tenant
###############################################################################

# @name qaSwitchToPatrickMorgan
POST {{qaCentaivaUrl}}/api/v1/me/switch-tenant HTTP/1.1
Authorization: Bearer {{qaEutopiaFinanceToken.response.body.$.access_token}}
Content-Type: application/json
Accept: application/json

{
  "tenantId": "{{patrickMorganTenantId}}",
  "applicationKey": "{{financeApplicationKey}}"
}

###


# @name qaPatrickMorganFinanceToken
POST {{qaCentaivaUrl}}/connect/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded
Accept: application/json

grant_type=urn%3Acentaiva%3Aparams%3Aoauth%3Agrant-type%3Atenant-selection&client_id={{financeClientId}}&selection_code={{qaSwitchToPatrickMorgan.response.body.$.selectionCode}}&scope={{financeScope}}

###


GET {{qaWorkwellUrl}}/api/platform-context HTTP/1.1
Authorization: Bearer {{qaPatrickMorganFinanceToken.response.body.$.access_token}}
Accept: application/json

###


###############################################################################
# E7 - NEGATIVE ISOLATION TEST
# Patrick Morgan token must not be able to force Eutopia CompId.
# Expected: 403.
###############################################################################

GET {{qaWorkwellUrl}}/api/dashboard/financial-dashboard HTTP/1.1
Authorization: Bearer {{qaPatrickMorganFinanceToken.response.body.$.access_token}}
X-Company-Id: {{eutopiaCompId}}
Accept: application/json

###



###############################################################################
# E8 - YVES WORKWELL LOGIN / TWO-CHILD ACCESS PROOF
#
# Expected eligible WORKWELL_FINANCE tenants:
# - Eutopia Search
# - Patrick Morgan
# MedPure must NOT be returned for this account.
###############################################################################

# @name qaWorkwellYvesFinancePreLogin
POST {{qaCentaivaUrl}}/connect/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded
Accept: application/json

grant_type=password&client_id=workwell-finance-web&username=yvesb%40workwelloutsourcing.com&password=Yvesb.workwell%40123&scope=openid%20profile%20email%20roles%20workwell.finance

###

GET {{qaCentaivaUrl}}/api/v1/me/tenants?applicationKey=WORKWELL_FINANCE HTTP/1.1
Authorization: Bearer {{qaWorkwellYvesFinancePreLogin.response.body.$.access_token}}
Accept: application/json

###


