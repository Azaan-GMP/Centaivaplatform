###############################################################################

PUT {{qaCentaivaUrl}}/api/v1/platform/users/{{qaUiUser.response.body.$.id}}/status HTTP/1.1
Authorization: Bearer {{qaPlatformOwnerLogin.response.body.$.access_token}}
Content-Type: application/json
Accept: application/json

{
  "status": 1,
  "reason": "QA UI lifecycle verification completed"
}

###


