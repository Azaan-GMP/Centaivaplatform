###############################################################################
# PART F - QA MEDPURE INSIDE WORKWELL_FINANCE
###############################################################################
###############################################################################


###############################################################################
# F1 - CENTRAL PLATFORM OWNER MUST SEE MEDPURE AS WORKWELL_FINANCE TENANT
###############################################################################

GET {{qaCentaivaUrl}}/api/v1/platform/tenants/resolve?identifier=MedPure&includeInactive=false HTTP/1.1
Authorization: Bearer {{qaPlatformOwnerLogin.response.body.$.access_token}}
Accept: application/json

###


###############################################################################
# F2 - MEDPURE YVES CENTRAL DIRECTORY LOOKUP
###############################################################################

# @name qaMedpureYvesUser
GET {{qaCentaivaUrl}}/api/v1/platform/users/by-email?email={{medpureYvesEmail}} HTTP/1.1
Authorization: Bearer {{qaPlatformOwnerLogin.response.body.$.access_token}}
Accept: application/json

###


###############################################################################
# F3 - MEDPURE YVES WORKWELL FINANCE LOGIN
#
# MedPure is NOT a separate application.
# Use workwell-finance-web + WORKWELL_FINANCE.
#
# If this account has only MedPure as an eligible tenant, Centaiva may
# immediately return a final MedPure tenant-bound token (no picker required).
###############################################################################

# @name qaMedpureYvesFinancePreLogin
POST {{qaCentaivaUrl}}/connect/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded
Accept: application/json

grant_type=password&client_id=workwell-finance-web&username=yvesb@medpure.com&password=Yvesb.medpure%40123&scope=openid%20profile%20email%20roles%20workwell.finance

###


###############################################################################
# F4 - MEDPURE YVES ELIGIBLE WORKWELL FINANCE TENANTS
#
# Expected:
#   MedPure only
#   Eutopia Search absent
#   Patrick Morgan absent
###############################################################################

# @name qaMedpureYvesTenants
GET {{qaCentaivaUrl}}/api/v1/me/tenants?applicationKey=WORKWELL_FINANCE HTTP/1.1
Authorization: Bearer {{qaMedpureYvesFinancePreLogin.response.body.$.access_token}}
Accept: application/json

###


###############################################################################
# F4A - MEDPURE YVES FINAL TOKEN CONTEXT
#
# If F3 auto-issued a final token because MedPure is the only eligible tenant,
# these requests must resolve MedPure and only MedPure.
###############################################################################

GET {{qaWorkwellUrl}}/api/platform-context HTTP/1.1
Authorization: Bearer {{qaMedpureYvesFinancePreLogin.response.body.$.access_token}}
Accept: application/json

###

GET {{qaWorkwellUrl}}/api/companies/me HTTP/1.1
Authorization: Bearer {{qaMedpureYvesFinancePreLogin.response.body.$.access_token}}
Accept: application/json

###


###############################################################################
# F5 - TALHA'S WORKWELL FINANCE TENANT PICKER
#
# Expected:
#   Eutopia Search
#   Patrick Morgan
#   MedPure
###############################################################################

GET {{qaCentaivaUrl}}/api/v1/me/tenants?applicationKey=WORKWELL_FINANCE HTTP/1.1
Authorization: Bearer {{qaTalhaFinancePreLogin.response.body.$.access_token}}
Accept: application/json

###


###############################################################################
# F6 - TALHA SELECTS MEDPURE USING SAME WORKWELL FINANCE CLIENT
###############################################################################

# @name qaSelectMedpure
POST {{qaCentaivaUrl}}/api/v1/me/select-tenant HTTP/1.1
Authorization: Bearer {{qaTalhaFinancePreLogin.response.body.$.access_token}}
Content-Type: application/json
Accept: application/json

{
  "tenantId": "{{medpureTenantId}}",
  "applicationKey": "WORKWELL_FINANCE"
}

