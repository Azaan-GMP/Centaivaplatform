###############################################################################
# CENTAIVA PLATFORM UI
# FULL QA + PRODUCTION IMPLEMENTATION / VERIFICATION TEST
#
# Source contract: Centaiva.Platform.Api OpenAPI v1
#
# PURPOSE
# - Implement and verify the Centaiva Platform Owner UI
# - QA first, then Production read-only verification
# - Central user / tenant / organization / RBAC administration
# - WorkWell Finance tenant discovery and switching
# - MedPure visibility through Centaiva Platform
# - Generic + WorkWell delegated onboarding
#
# IMPORTANT SECURITY MODEL
# - Centaiva is the identity and tenant authority.
# - Centaiva Platform Control token is tenantless for Platform Owner.
# - A final product token such as WORKWELL_FINANCE is bound to one application + one tenant.
# - Do not switch WorkWell by changing CompId locally.
# - Use /api/v1/me/select-tenant for initial selection.
# - Use /api/v1/me/switch-tenant after login.
# - The compatibility /select-tenant route may also accept a final same-app token.
###############################################################################


###############################################################################
# 0 - URLS
###############################################################################

# QA
@qaCentaivaUrl = https://api.workwell.centaiva.com
@qaWorkwellUrl = http://192.168.88.27:8091
@qaWorkwellWebUrl = http://localhost:4200

# Production
@prodCentaivaUrl = https://oauth.centaiva.com
@prodWorkwellUrl = https://api.workwell.centaiva.com
@prodWorkwellWebUrl = https://workwell.centaiva.com


###############################################################################
# 0A - SSO / APPLICATIONS
###############################################################################

@platformClientId = centaiva-platform-web
@platformScope = openid%20profile%20email%20roles%20centaiva.platform

@financeClientId = workwell-finance-web
@financeScope = openid%20profile%20email%20roles%20workwell.finance
@financeApplicationKey = WORKWELL_FINANCE
@financeApplicationId = 1DECD47E-4A96-F111-80F8-00155D581206

# MedPure is another tenant inside WORKWELL_FINANCE.
# It intentionally uses the same WorkWell Finance application/client.
@medpureClientId = workwell-finance-web
@medpureScope = openid%20profile%20email%20roles%20workwell.finance
@medpureApplicationKey = WORKWELL_FINANCE
@medpureApplicationId = 1DECD47E-4A96-F111-80F8-00155D581206


###############################################################################
# 0B - COPY/PASTE CREDENTIALS
###############################################################################

# CENTAIVA PLATFORM OWNER / SSO
@platformOwnerEmail = talha.hassan@centaiva.com
@platformOwnerPassword = Password123!
@mfaCode = REPLACE_WITH_CURRENT_6_DIGIT_MFA

# WORKWELL FINANCE
@superAdminEmail = superadmin@workwell.com
@superAdminPassword = Password123!

@workwellYvesEmail = yvesb@workwelloutsourcing.com
@workwellYvesPassword = Yvesb.workwell@123

@matthewEmail = matthew.jaques@workwelloutsourcing.com
@matthewPassword = Matthew.jaques123!@#

@paulEmail = paul.griffin@workwelloutsourcing.com
@paulPassword = Paul.griffin123#@!

# MEDPURE
@medpureYvesEmail = yvesb@medpure.com
@medpureYvesPassword = Yvesb.medpure@123


###############################################################################
# 0C - TENANTS / COMPANY MAPPING
###############################################################################

# Known WorkWell Finance tenant
@eutopiaTenantId = D445FE51-5196-F111-80F8-00155D581206
@eutopiaCompId = 1

# Fill after Platform -> Tenants confirms the actual records.
@patrickMorganTenantId = REPLACE_WITH_PATRICK_MORGAN_TENANT_GUID
@patrickMorganCompId = REPLACE_WITH_PATRICK_MORGAN_WORKWELL_COMPID

@medpureTenantId = REPLACE_WITH_MEDPURE_TENANT_GUID


###############################################################################
# 0D - EXPECTED ACCESS / HIERARCHY MODEL
###############################################################################

# WORKWELL_FINANCE product/application
#
#   WorkWell parent organization
#     - Eutopia Search tenant/company
#     - Patrick Morgan tenant/company
#
#   MedPure tenant/company
#
# talha.hassan@centaiva.com
#   Platform Owner
#   Can centrally see/select all three WORKWELL_FINANCE tenants:
#     - Eutopia Search
#     - Patrick Morgan
#     - MedPure
#
# yvesb@workwelloutsourcing.com
#   WORKWELL_FINANCE:
#     - Eutopia Search
#     - Patrick Morgan
#
# yvesb@medpure.com
#   WORKWELL_FINANCE:
#     - MedPure only
###############################################################################



###############################################################################
###############################################################################
# PART A - QA PLATFORM OWNER LOGIN / SHELL BOOTSTRAP
###############################################################################
###############################################################################


###############################################################################
# A1 - QA PLATFORM OWNER LOGIN
# Expected: 200 token
###############################################################################

# @name qaPlatformOwnerLogin
POST {{qaCentaivaUrl}}/connect/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded
Accept: application/json

grant_type=password&client_id=centaiva-platform-web&username=talha.hassan@centaiva.com&password=Password123!&scope=openid%20profile%20email%20roles%20centaiva.platform

###


###############################################################################
# A2 - CURRENT CONTEXT
###############################################################################

GET {{qaCentaivaUrl}}/api/v1/context/me HTTP/1.1
Authorization: Bearer {{qaPlatformOwnerLogin.response.body.$.access_token}}
Accept: application/json

###


###############################################################################
# A3 - PLATFORM BOOTSTRAP
# UI use:
# - shell identity
# - top-level navigation
# - platform metadata
###############################################################################

GET {{qaCentaivaUrl}}/api/v1/platform/bootstrap HTTP/1.1
Authorization: Bearer {{qaPlatformOwnerLogin.response.body.$.access_token}}
Accept: application/json

###


###############################################################################
# A4 - PLATFORM OWNER ADMIN SCOPE
# UI should use this to decide global control visibility.
###############################################################################

GET {{qaCentaivaUrl}}/api/v1/platform/me/admin-scope HTTP/1.1
Authorization: Bearer {{qaPlatformOwnerLogin.response.body.$.access_token}}
Accept: application/json

###


###############################################################################
# A5 - MY ADMIN SCOPE
###############################################################################

GET {{qaCentaivaUrl}}/api/v1/me/admin-scope HTTP/1.1
Authorization: Bearer {{qaPlatformOwnerLogin.response.body.$.access_token}}
Accept: application/json

###


###############################################################################
# A6 - PLATFORM CONTROL TOKEN IS TENANTLESS
#
# Do NOT call /api/v1/me/session-policy with qaPlatformOwnerLogin.
# Session policy is tenant-specific and is tested after a WORKWELL_FINANCE
# tenant has been selected and exchanged for a final tenant-bound token.
#
# Expected Platform token:
#   application = CENTAIVA_CONTROL_WEB
#   role includes PLATFORM_OWNER
#   tenant_id absent
###############################################################################


###############################################################################
# A7 - CENTRAL ACCESS SNAPSHOT
###############################################################################

GET {{qaCentaivaUrl}}/api/v1/me/access-snapshot HTTP/1.1
Authorization: Bearer {{qaPlatformOwnerLogin.response.body.$.access_token}}
Accept: application/json

###



###############################################################################
###############################################################################
# PART B - QA PLATFORM DIRECTORY UI
###############################################################################
###############################################################################


###############################################################################
